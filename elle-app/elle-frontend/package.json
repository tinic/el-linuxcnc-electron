{
  "name": "elle-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build --emptyOutDir",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/**/*.{js,ts,vue}",
    "lint:fix": "eslint src/**/*.{js,ts,vue} --fix",
    "generate:api": "python3 ../elle-hal/generate_schema.py && json2ts -i ../api-schema.json -o src/api/types.gen.ts --unreachableDefinitions --bannerComment '/* eslint-disable */\n/* AUTO-GENERATED from api-schema.json - do not edit. Run: yarn generate:api */'"
  },
  "dependencies": {
    "@primevue/themes": "4.3.5",
    "primeflex": "4.0.0",
    "primeicons": "7.0.0",
    "primevue": "4.3.5",
    "three": "^0.185.1",
    "troisjs": "^0.3.4",
    "vue": "^3.5.40",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/three": "^0.185.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  }
}
